#!/bin/sh

set -u

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)

usage() {
    cat <<'EOF'
Usage: codex-switch <profile>
       codex-switch switch <profile>
       codex-switch next
       codex-switch auto
       codex-switch run [<profile>] [--] [codex arguments...]
       codex-switch add <profile>
       codex-switch login <profile> [codex login arguments...]
       codex-switch auth <profile> [codex login arguments...]
       codex-switch logout <profile>
       codex-switch status [<profile>]
       codex-switch dashboard [--json] [--watch] [<profile>]
       codex-switch home [--json] [--watch] [<profile>]
       codex-switch remove <profile>
       codex-switch list
       codex-switch current
       codex-switch shell-init
       codex-switch --help

Manage isolated Codex authentication profiles. The one-argument form selects a
profile. Run Codex safely with "codex-switch run", or evaluate the output of
"codex-switch shell-init" so ordinary codex commands use the selected profile.
EOF
}

fail() {
    printf 'codex-switch: %s\n' "$1" >&2
    exit "${2-1}"
}

valid_profile_name() {
    case $1 in
        ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*|add|auth|auto|current|dashboard|help|home|list|login|logout|next|remove|run|shell-init|status|switch) return 1 ;;
        *) return 0 ;;
    esac
}

require_profile_name() {
    valid_profile_name "$1" || fail "invalid profile name: $1" 64
}

require_profile() {
    { [ -d "$1" ] && [ ! -L "$1" ]; } || fail "profile does not exist: $2"
}

require_auth() {
    if [ ! -f "$1" ] || [ ! -r "$1" ] || [ ! -s "$1" ]; then
        fail "profile is not signed in: $2 (run: codex-switch login $2)"
    fi
}

write_marker() {
    marker_value=$1
    marker_tmp=$(mktemp "${active_home}/..codex-switch-active.XXXXXX") ||
        fail "could not create a temporary marker in ${active_home}"
    if ! printf '%s\n' "$marker_value" > "$marker_tmp" ||
       ! chmod 600 "$marker_tmp" || ! mv -f "$marker_tmp" "$active_marker"; then
        rm -f "$marker_tmp"
        marker_tmp=
        fail 'could not update the active-profile marker'
    fi
    marker_tmp=
}

link_shared_item() {
    shared_name=$1
    shared_source="${active_home}/${shared_name}"
    shared_destination="${profile_home}/${shared_name}"

    [ -e "$shared_source" ] || [ -L "$shared_source" ] || return 0
    [ ! -e "$shared_destination" ] && [ ! -L "$shared_destination" ] || return 0
    ln -s "$shared_source" "$shared_destination" ||
        fail "could not share ${shared_name} with profile ${profile}"
}

shared_item_is_directory() {
    case $1 in
        sessions|archived_sessions|thread-writer-locks) return 0 ;;
        *) return 1 ;;
    esac
}

ensure_shared_item() {
    shared_name=$1
    shared_source="${active_home}/${shared_name}"

    if [ -e "$shared_source" ] || [ -L "$shared_source" ]; then
        return 0
    fi

    if shared_item_is_directory "$shared_name"; then
        mkdir -p "$shared_source" || fail "could not create shared ${shared_name}"
    else
        : > "$shared_source" || fail "could not create shared ${shared_name}"
        chmod 600 "$shared_source" || fail "could not protect shared ${shared_name}"
    fi
}

merge_shared_tree() {
    source_tree=$1
    destination_tree=$2

    mkdir -p "$destination_tree" || fail "could not create shared state directory: ${destination_tree}"
    find "$source_tree" -type d -print | while IFS= read -r source_directory; do
        relative_path=${source_directory#"${source_tree}"/}
        [ "$relative_path" = "$source_directory" ] && relative_path=
        if [ -n "$relative_path" ]; then
            mkdir -p "${destination_tree}/${relative_path}" ||
                fail "could not merge shared state directory: ${relative_path}"
        fi
    done
    find "$source_tree" -type f -print | while IFS= read -r source_file; do
        relative_path=${source_file#"${source_tree}"/}
        destination_file="${destination_tree}/${relative_path}"
        if { [ ! -e "$destination_file" ] && [ ! -L "$destination_file" ]; } ||
           [ "$source_file" -nt "$destination_file" ]; then
            mkdir -p "${destination_file%/*}" ||
                fail "could not create shared state parent: ${destination_file%/*}"
            cp -p "$source_file" "$destination_file" ||
                fail "could not merge shared session: ${relative_path}"
        fi
    done
}

append_shared_file() {
    source_file=$1
    additional_file=$2
    merged_file=$(mktemp "${active_home}/.codex-switch-shared.XXXXXX") ||
        fail 'could not create a shared-state temporary file'
    if ! cat "$source_file" "$additional_file" > "$merged_file" ||
       ! chmod 600 "$merged_file" || ! mv -f "$merged_file" "$source_file"; then
        rm -f "$merged_file"
        fail "could not merge shared session history: ${source_file}"
    fi
}

merge_profile_shared_item() {
    profile_name=$1
    shared_name=$2
    shared_source="${active_home}/${shared_name}"
    profile_item="${HOME}/.codex-${profile_name}/${shared_name}"

    ensure_shared_item "$shared_name"
    if [ -L "$profile_item" ] && [ "$(readlink "$profile_item" 2>/dev/null || :)" = "$shared_source" ]; then
        return 0
    fi

    if [ -e "$profile_item" ] || [ -L "$profile_item" ]; then
        legacy_item="${active_home}/.codex-switch-legacy-state/${profile_name}/${shared_name}"
        mkdir -p "${legacy_item%/*}" || fail "could not create legacy state directory for ${profile_name}"
        [ ! -e "$legacy_item" ] && [ ! -L "$legacy_item" ] ||
            fail "legacy state already exists for ${profile_name}/${shared_name}; resolve it before retrying"
        mv "$profile_item" "$legacy_item" ||
            fail "could not preserve existing ${profile_name}/${shared_name} state"
        if shared_item_is_directory "$shared_name"; then
            merge_shared_tree "$legacy_item" "$shared_source"
        elif [ -s "$legacy_item" ]; then
            if [ ! -s "$shared_source" ]; then
                cp -p "$legacy_item" "$shared_source" ||
                    fail "could not preserve ${profile_name}/${shared_name} history"
            else
                append_shared_file "$shared_source" "$legacy_item"
            fi
        fi
    fi

    ln -s "$shared_source" "$profile_item" ||
        fail "could not share ${shared_name} with profile ${profile_name}"
}

prepare_shared_profile_state() {
    # Session transcripts and history are deliberately shared. Credentials and
    # runtime databases are kept separate from profile-scoped CODEX_HOME auth.
    for shared_name in sessions archived_sessions history.jsonl session_index.jsonl transcription-history.jsonl thread-writer-locks; do
        ensure_shared_item "$shared_name"
    done

    for candidate_home in "${HOME}"/.codex-*; do
        [ -d "$candidate_home" ] || continue
        candidate_profile=${candidate_home##*/.codex-}
        valid_profile_name "$candidate_profile" || continue
        for shared_name in sessions archived_sessions history.jsonl session_index.jsonl transcription-history.jsonl thread-writer-locks; do
            merge_profile_shared_item "$candidate_profile" "$shared_name"
        done
    done

    # The current profile may not have existed when the loop above ran (login
    # and add create it during the command), so make its links explicit.
    for shared_name in sessions archived_sessions history.jsonl session_index.jsonl transcription-history.jsonl thread-writer-locks; do
        merge_profile_shared_item "$profile" "$shared_name"
    done
}

sqlite_migration_needed() {
    for candidate_home in "${HOME}"/.codex-*; do
        [ -d "$candidate_home" ] && [ ! -L "$candidate_home" ] || continue
        candidate_profile=${candidate_home##*/.codex-}
        valid_profile_name "$candidate_profile" || continue
        marker="${active_home}/.codex-switch-legacy-state/${candidate_profile}/sqlite/.merged-v1"
        [ -f "$marker" ] && continue
        for database_name in state_5.sqlite thread_history_1.sqlite goals_1.sqlite queue_1.sqlite memories_1.sqlite logs_2.sqlite agent_message_board_1.sqlite; do
            [ ! -f "${candidate_home}/${database_name}" ] || return 0
        done
    done
    return 1
}

migrate_sqlite_state() {
    sqlite_migration_needed || return 0
    migration_helper=${CODEX_SWITCH_MIGRATION_HELPER-"${script_dir}/codex-switch-migrate.py"}
    [ -f "$migration_helper" ] || fail "could not find SQLite migration helper: ${migration_helper}"

    if [ -n "${CODEX_SWITCH_PYTHON-}" ]; then
        python_command=$CODEX_SWITCH_PYTHON
    elif command -v python3 >/dev/null 2>&1; then
        python_command=python3
    elif command -v python >/dev/null 2>&1; then
        python_command=python
    else
        fail 'Python 3 is required once to merge existing profile session metadata'
    fi
    "$python_command" "$migration_helper" --active-home "$active_home" ||
        fail 'legacy profile session metadata could not be migrated; close running Codex sessions and retry'
}

prepare_profile_home() {
    mkdir -p "$profile_home" || fail "could not create profile: ${profile}"

    migrate_sqlite_state
    prepare_shared_profile_state

    # Authentication and SQLite/runtime state remain isolated. These read-mostly
    # items are shared so profiles keep the user's normal configuration and extensions.
    link_shared_item config.toml
    link_shared_item skills
    link_shared_item plugins
    link_shared_item packages
}

remove_managed_link() {
    managed_name=$1
    managed_path="${profile_home}/${managed_name}"
    managed_target="${active_home}/${managed_name}"
    if [ -L "$managed_path" ] && [ "$(readlink "$managed_path" 2>/dev/null || :)" = "$managed_target" ]; then
        rm -f "$managed_path" || fail "could not remove managed link: ${managed_path}"
    fi
}

remove_shared_managed_links() {
    for shared_name in sessions archived_sessions history.jsonl session_index.jsonl transcription-history.jsonl thread-writer-locks; do
        managed_path="${profile_home}/${shared_name}"
        managed_target="${active_home}/${shared_name}"
        if [ -L "$managed_path" ] && [ "$(readlink "$managed_path" 2>/dev/null || :)" = "$managed_target" ]; then
            rm -f "$managed_path" || fail "could not remove managed link: ${managed_path}"
        fi
    done
}

find_codex() {
    codex_command=${CODEX_SWITCH_CODEX_BIN-codex}
    [ -n "$codex_command" ] || fail 'CODEX_SWITCH_CODEX_BIN must not be empty'
    command -v "$codex_command" >/dev/null 2>&1 ||
        fail "could not find Codex executable: ${codex_command}"
}

exec_codex() {
    find_codex
    prepare_profile_home
    CODEX_HOME=$profile_home
    CODEX_SQLITE_HOME=$active_home
    export CODEX_HOME
    export CODEX_SQLITE_HOME
    unset OPENAI_API_KEY CODEX_API_KEY CODEX_ACCESS_TOKEN OPENAI_IDENTITY_TOKEN_FILE OPENAI_FEDERATION_RULE_ID

    # File storage is intentional: auth.json is explicitly namespaced by
    # CODEX_HOME. Each profile therefore owns one refresh-token cache.
    # Keep Codex attached to the terminal, with its output unchanged. On a
    # failure, ask Codex itself for auth details before adding a recovery hint.
    "$codex_command" -c 'cli_auth_credentials_store="file"' "$@"
    codex_exit=$?
    if [ "$codex_exit" -eq 1 ] && { [ "$command_name" = run ] || [ "$command_name" = status ]; }; then
        dashboard_helper=${CODEX_SWITCH_DASHBOARD_HELPER-"${script_dir}/codex-switch-dashboard.py"}
        if [ -f "$dashboard_helper" ] && command -v python3 >/dev/null 2>&1; then
            python3 "$dashboard_helper" --diagnose "$codex_command" "$profile" || :
        fi
    fi
    exit "$codex_exit"
}

case "${1-}" in
    -h|--help|help)
        [ "$#" -eq 1 ] || { usage >&2; exit 64; }
        usage
        exit 0
        ;;
esac

if [ "$#" -eq 0 ]; then
    printf '%s\n\n' 'codex-switch: a command or profile is required' >&2
    usage >&2
    exit 64
fi

case ${HOME-} in
    /*) ;;
    *) fail 'HOME must be set to an absolute path' ;;
esac

active_home="${HOME}/.codex"
active_marker="${active_home}/.codex-switch-active"
marker_tmp=
cleanup() {
    [ -z "$marker_tmp" ] || rm -f "$marker_tmp"
}
trap 'cleanup' EXIT HUP INT TERM

active_profile=
if [ -f "$active_marker" ] && IFS= read -r marker_profile < "$active_marker" &&
   valid_profile_name "$marker_profile"; then
    active_profile=$marker_profile
fi

command_name=$1
case $command_name in
    switch)
        [ "$#" -eq 2 ] || fail "${command_name} requires exactly one profile" 64
        if [ "$2" = "auto" ] || [ "$2" = "next" ]; then
            command_name=next
        else
            profile=$2
            require_profile_name "$profile"
        fi
        ;;
    add|logout|remove)
        [ "$#" -eq 2 ] || fail "${command_name} requires exactly one profile" 64
        profile=$2
        require_profile_name "$profile"
        ;;
    auth|login)
        [ "$#" -ge 2 ] || fail "${command_name} requires a profile" 64
        profile=$2
        require_profile_name "$profile"
        ;;
    current|list|shell-init)
        [ "$#" -eq 1 ] || fail "${command_name} does not accept arguments" 64
        ;;
    dashboard|home|next|auto)
        ;;
    run)
        ;;
    status)
        ;;
    *)
        [ "$#" -eq 1 ] || fail 'expected exactly one profile argument' 64
        command_name=switch
        profile=$1
        require_profile_name "$profile"
        ;;
esac

umask 077
mkdir -p "$active_home" || fail "could not create Codex home: ${active_home}"

case $command_name in
    current)
        [ -n "$active_profile" ] || fail 'no active profile'
        printf '%s\n' "$active_profile"
        ;;
    shell-init)
        cat <<'EOF'
# Route ordinary Codex CLI commands through the active codex-switch profile.
codex() {
    command codex-switch run -- "$@"
}
EOF
        ;;
    list)
        for profile_dir in "${HOME}"/.codex-*; do
            [ -d "$profile_dir" ] && [ ! -L "$profile_dir" ] || continue
            profile=${profile_dir##*/.codex-}
            valid_profile_name "$profile" || continue
            suffix=
            if [ ! -f "$profile_dir/auth.json" ] || [ ! -r "$profile_dir/auth.json" ] ||
               [ ! -s "$profile_dir/auth.json" ]; then
                suffix='\t(signed out)'
            fi
            if [ "$profile" = "$active_profile" ]; then
                suffix="${suffix}\t(active)"
            fi
            printf '%s%b\n' "$profile" "$suffix"
        done | sort
        ;;
    add)
        profile_home="${HOME}/.codex-${profile}"
        [ ! -e "$profile_home" ] || fail "profile already exists: ${profile}"
        prepare_profile_home
        write_marker "$profile"
        printf 'Added and selected Codex profile: %s\n' "$profile"
        printf 'Sign in with: codex-switch login %s\n' "$profile"
        ;;
    auth|login)
        shift 2
        profile_home="${HOME}/.codex-${profile}"
        if [ ! -d "$profile_home" ]; then
            prepare_profile_home
        fi
        write_marker "$profile"
        exec_codex login "$@"
        ;;
    logout)
        profile_home="${HOME}/.codex-${profile}"
        require_profile "$profile_home" "$profile"
        exec_codex logout
        ;;
    remove)
        profile_home="${HOME}/.codex-${profile}"
        if [ -L "$profile_home" ]; then
            rm -f "$profile_home" || fail "could not remove profile symlink: ${profile}"
            printf 'Removed Codex profile: %s\n' "$profile"
            exit 0
        fi
        require_profile "$profile_home" "$profile"
        [ "$profile" != "$active_profile" ] || fail "cannot remove active profile: ${profile}"
        rm -f "$profile_home/auth.json" || fail "could not remove credentials for ${profile}"
        remove_managed_link config.toml
        remove_managed_link skills
        remove_managed_link plugins
        remove_managed_link packages
        remove_shared_managed_links
        rmdir "$profile_home" 2>/dev/null || :
        printf 'Removed Codex profile: %s\n' "$profile"
        ;;
    switch)
        profile_home="${HOME}/.codex-${profile}"
        require_profile "$profile_home" "$profile"
        require_auth "${profile_home}/auth.json" "$profile"
        prepare_profile_home
        write_marker "$profile"
        printf 'Selected Codex profile: %s\n' "$profile"
        ;;
    next|auto)
        if [ "$1" = "switch" ]; then
            shift 2
        else
            shift
        fi
        dashboard_helper=${CODEX_SWITCH_DASHBOARD_HELPER-"${script_dir}/codex-switch-dashboard.py"}
        [ -f "$dashboard_helper" ] || fail "could not find dashboard helper: ${dashboard_helper}"
        if [ -n "${CODEX_SWITCH_PYTHON-}" ]; then
            python_command=$CODEX_SWITCH_PYTHON
        elif command -v python3 >/dev/null 2>&1; then
            python_command=python3
        elif command -v python >/dev/null 2>&1; then
            python_command=python
        else
            fail 'Python 3 is required for profile auto-rotation'
        fi
        find_codex
        exec "$python_command" "$dashboard_helper" --codex-bin "$codex_command" --next "$@"
        ;;
    dashboard|home)
        shift
        dashboard_helper=${CODEX_SWITCH_DASHBOARD_HELPER-"${script_dir}/codex-switch-dashboard.py"}
        [ -f "$dashboard_helper" ] || fail "could not find dashboard helper: ${dashboard_helper}"
        if [ -n "${CODEX_SWITCH_PYTHON-}" ]; then
            python_command=$CODEX_SWITCH_PYTHON
        elif command -v python3 >/dev/null 2>&1; then
            python_command=python3
        elif command -v python >/dev/null 2>&1; then
            python_command=python
        else
            fail 'Python 3 is required for the profile dashboard'
        fi
        find_codex
        exec "$python_command" "$dashboard_helper" --codex-bin "$codex_command" "$@"
        ;;
    status)
        if [ "$#" -ge 2 ] && { [ "$2" = "--dashboard" ] || [ "$2" = "--all" ] || [ "$2" = "-d" ] || [ "$2" = "--json" ]; }; then
            flag=$2
            shift 2
            dashboard_helper=${CODEX_SWITCH_DASHBOARD_HELPER-"${script_dir}/codex-switch-dashboard.py"}
            [ -f "$dashboard_helper" ] || fail "could not find dashboard helper: ${dashboard_helper}"
            if [ -n "${CODEX_SWITCH_PYTHON-}" ]; then
                python_command=$CODEX_SWITCH_PYTHON
            elif command -v python3 >/dev/null 2>&1; then
                python_command=python3
            elif command -v python >/dev/null 2>&1; then
                python_command=python
            else
                fail 'Python 3 is required for the profile dashboard'
            fi
            find_codex
            exec "$python_command" "$dashboard_helper" --codex-bin "$codex_command" "$flag" "$@"
        fi
        if [ "$#" -eq 2 ]; then
            profile=$2
            require_profile_name "$profile"
        else
            [ -n "$active_profile" ] || fail 'no active profile'
            profile=$active_profile
        fi
        profile_home="${HOME}/.codex-${profile}"
        require_profile "$profile_home" "$profile"
        exec_codex login status
        ;;
    run)
        shift
        if [ "${1-}" = -- ]; then
            shift
            [ -n "$active_profile" ] || fail 'no active profile; select one with: codex-switch <profile>'
            profile=$active_profile
        elif [ "$#" -gt 0 ] && valid_profile_name "$1" && [ -d "${HOME}/.codex-$1" ]; then
            profile=$1
            shift
            write_marker "$profile"
        else
            [ -n "$active_profile" ] || fail 'run requires a profile when none is active' 64
            profile=$active_profile
        fi
        profile_home="${HOME}/.codex-${profile}"
        require_profile "$profile_home" "$profile"
        exec_codex "$@"
        ;;
esac
